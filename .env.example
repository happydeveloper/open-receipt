# 이 파일을 .env.local로 복사해 값을 넣으세요. .env.local은 커밋되지 않습니다.

# Liner Platform API 키 (https://platform.liner.com/keys). 절대 커밋하지 마세요.
# 비워 두면 에이전트 없이 직접 입력으로만 쓸 수 있습니다.
LINER_API_KEY=

# 선택: 모델 이름. 기본값 liner-gpt-router
LINER_MODEL=

# 선택: 배포 환경에서 단체 공간(기기 간 동기화)에 쓰는 Vercel Blob 토큰.
# Vercel에서 Blob 저장소를 연결하면 자동으로 들어갑니다. 로컬 개발에서는 .data/ 폴더를 씁니다.
BLOB_READ_WRITE_TOKEN=

# 선택: 소스 저장소 주소. 넣으면 소개 페이지에 "소스 코드 받기" 버튼이 나옵니다.
NEXT_PUBLIC_SOURCE_URL=
